# Paper-default DeepSeek-R1-Distill-Qwen-7B configuration.
# Set MODEL_PATH to a local checkpoint or a Hugging Face model id before
# running scripts/train_ruar.sh.

N_GPUS=2
FINAL_CHECKPOINT_STEP=30
# The trainer starts its one-based global counter at 1 and stops when it
# reaches TOTAL_STEPS, so 31 executes 30 policy updates and saves step 30.
TOTAL_STEPS=31
SAVE_FREQ=30
TEST_FREQ=-1
RUN_FINAL_VALIDATION=False
REFLECTION_STOP_AFTER_READY=True
RUN_CONDITION=ruar_wait_wait_rloo
RUN_TAG=ruar_ds7b_numina_3k_30step
RUN_SUFFIX=ds7b_2gpu_train8_updates30_s30_wait_wait_answerready_lp02_m18k_r16k

# Shared online RL configuration.
ROLLOUT_N=16
TRAIN_BATCH_SIZE=8
PPO_MINI_BATCH_SIZE=16
ACTOR_LR=2e-6
MAX_MODEL_LEN=18432
MAX_PROMPT_LENGTH=2048
MAX_RESPONSE_LENGTH=16384
MAX_NUM_BATCHED_TOKENS=18432
TOKEN_BUDGET=32768
LENGTH_PENALTY_ENABLE=True
LENGTH_PENALTY_COEF=0.2
LENGTH_PENALTY_TARGET=8192
LENGTH_PENALTY_MODE=correct_group_sigmoid
LENGTH_PENALTY_CAP=1.0
LENGTH_PENALTY_STD_FLOOR=0.0
LENGTH_PENALTY_ONLY_CORRECT=True
REWARD_GT_COEF=1
ACTOR_USE_KL_LOSS=False

# Utility-guided and post-ready advantage rescaling.
ADVANTAGE_SCALING_ENABLE=True
ADVANTAGE_SCALING_READY_THRESHOLD=0.75
ADVANTAGE_SCALING_CONSECUTIVE_REQUIRED=3
ADVANTAGE_SCALING_SCOPE=all_post_ready
ADVANTAGE_SCALING_EXCLUDE_FINAL_ANSWER=True
ADVANTAGE_SCALING_POST_READY_DEFAULT_GAMMA_POS=0.25
ADVANTAGE_SCALING_POST_READY_DEFAULT_GAMMA_NEG=1.25
ADVANTAGE_SCALING_PRE_READY_NEGATIVE_GAMMA=1.0
ADVANTAGE_SCALING_APPLY_TO_ALL_WAIT=True

# DeepSeek backbones use Wait as both the step-start and step-end delimiter.
REFLECTION_CUE_TYPES="['wait']"
REFLECTION_END_CUE_TYPES="['wait']"
REFLECTION_MAX_SPANS_PER_SAMPLE=0
REFLECTION_SPAN_SELECTION=first
REFLECTION_ANSWER_ROLLOUTS=4
REFLECTION_MAX_ANSWER_TOKENS=16
REFLECTION_LABEL_FILTER=signed
REFLECTION_LABEL_THRESHOLD=0.0
REFLECTION_LENGTH_AWARE_GAMMA=0.0
REFLECTION_LENGTH_AWARE_TARGET=128
REFLECTION_LENGTH_AWARE_SCOPE=response
REFLECTION_POST_ANSWER_MODE=off
REFLECTION_POST_ANSWER_PENALTY=0.0
REFLECTION_POST_ANSWER_THRESHOLD=1.0
REFLECTION_CLASS_THRESHOLD=0.75
REFLECTION_PERSISTENT_ROLLOUT_SESSION=True
REFLECTION_PERSISTENT_VERIFY_POOL=True
REFLECTION_PROBE_BATCH_SIZE=0
REFLECTION_VERIFY_BATCH_SIZE=512
