# Export this file before RUAR/scripts/train_ruar_qwen3_8b.sh for the
# paper-aligned Qwen3-8B reproduction defaults:
#
#   set -a
#   source configs/ruar_qwen3_8b.env
#   set +a
#
# Set MODEL_PATH separately to a local Qwen3-8B checkpoint or Hugging Face
# model id accepted by your environment.

TOTAL_STEPS=50
SAVE_FREQ=50
TEST_FREQ=-1
RUN_FINAL_VALIDATION=False
REFLECTION_STOP_AFTER_READY=True

# Paper RUAR hyperparameters.
ROLLOUT_N=16
TRAIN_BATCH_SIZE=8
PPO_MINI_BATCH_SIZE=16
ACTOR_LR=2e-6
MAX_MODEL_LEN=18432
MAX_PROMPT_LENGTH=2048
MAX_RESPONSE_LENGTH=16384
MAX_NUM_BATCHED_TOKENS=18432
TOKEN_BUDGET=32768
LENGTH_PENALTY_ENABLE=True
LENGTH_PENALTY_COEF=0.2
LENGTH_PENALTY_MODE=correct_group_sigmoid
LENGTH_PENALTY_STD_FLOOR=0.0
LENGTH_PENALTY_ONLY_CORRECT=True
REWARD_GT_COEF=1
ACTOR_USE_KL_LOSS=False
ADVANTAGE_SCALING_ENABLE=True
ADVANTAGE_SCALING_READY_THRESHOLD=0.75
ADVANTAGE_SCALING_CONSECUTIVE_REQUIRED=3
ADVANTAGE_SCALING_EXCLUDE_FINAL_ANSWER=True
ADVANTAGE_SCALING_POST_READY_DEFAULT_GAMMA_POS=0.25
ADVANTAGE_SCALING_POST_READY_DEFAULT_GAMMA_NEG=1.25
# 0 means no cap: use all extracted Wait-start spans until
# REFLECTION_STOP_AFTER_READY stops further answer-forcing probes.
REFLECTION_MAX_SPANS_PER_SAMPLE=0
